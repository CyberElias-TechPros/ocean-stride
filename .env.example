# No client-side configuration or VITE_* secrets are needed.
# Configure these server-side variables in Vercel, not in the browser:
API_WORKER_ORIGIN=
INTERNAL_PROXY_SECRET=
# Worker: set APP_ORIGIN / D1 IDs in wrangler.jsonc, and put the same
# INTERNAL_PROXY_SECRET into Cloudflare using wrangler secret put.
