# Ocean Stride environment configuration
#
# Copy this file to `.env` and fill in your deployed Cloudflare Worker values.
# In development, the Vite dev server can proxy `/api` to a local Worker.

# Public base URL of the deployed Cloudflare Worker.
# Example: VITE_API_BASE_URL=https://ocean-stride-api.your-subdomain.workers.dev
# Leave unset (or set to /api) to use the Vite dev-server proxy during local dev.
VITE_API_BASE_URL=

# Keep the frontend on the Worker-backed API. Do not set to "false" in production.
VITE_REMOTE_DB=true
